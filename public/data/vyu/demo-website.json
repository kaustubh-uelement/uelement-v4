  "findings": [
    {
      "id": "F01",
      "title": "Key exchange is classical only: recorded traffic can be decrypted later",
      "severity": "critical",
      "category": "key-exchange",
      "quantum": true,
      "hosts": [
        "www.demo-bank.example:443"
      ],
      "detail": "Every session to www.demo-bank.example is protected by classical ECDH or RSA key exchange. An adversary who records this traffic today can decrypt it once a cryptographically relevant quantum computer exists (harvest now, decrypt later). With a 12-year data horizon, this is the first thing to fix.",
      "evidence": "observed",
      "proof": [
        "TLS 1.3 groups accepted (server's pick order): x25519, secp256r1, secp384r1",
        "Offered X25519MLKEM768, SecP256r1MLKEM768, SecP384r1MLKEM1024 and pure ML-KEM: none accepted"
      ],
      "fix": "Enable hybrid X25519MLKEM768 key exchange at the TLS termination point (CDN, load balancer or web server). Browsers already offer it, so no client change is needed.",
      "owner": "CDN / load balancer / web server team",
      "effort": "Low: configuration change on PQ-capable software",
      "snippets": [
        {
          "label": "nginx (built with OpenSSL 3.5+)",
          "code": "ssl_protocols TLSv1.2 TLSv1.3;\nssl_ecdh_curve X25519MLKEM768:X25519:prime256v1;"
        },
        {
          "label": "HAProxy (OpenSSL 3.5+)",
          "code": "global\n    ssl-default-bind-curves X25519MLKEM768:X25519:P-256"
        },
        {
          "label": "Go services",
          "code": "// Go 1.24+ offers X25519MLKEM768 by default.\n// Leave tls.Config.CurvePreferences unset (or list tls.X25519MLKEM768 first)."
        }
      ],
      "standards": [
        "NIST FIPS 203 (ML-KEM)",
        "NIST IR 8547 (draft): quantum-vulnerable public-key algorithms deprecated after 2030, disallowed after 2035",
        "NIST SP 1800-38: migration to post-quantum cryptography"
      ],
      "phase": 1
    },
    {
      "id": "F02",
      "title": "RSA key-transport suites accepted (no forward secrecy)",
      "severity": "high",
      "category": "key-exchange",
      "quantum": true,
      "hosts": [
        "www.demo-bank.example:443"
      ],
      "detail": "These suites encrypt the session key directly to the server's RSA key. Whoever obtains that key later, through a breach or a quantum computer, can decrypt every recorded session at once.",
      "evidence": "observed",
      "proof": [
        "TLS_RSA_WITH_AES_256_GCM_SHA384",
        "TLS_RSA_WITH_AES_128_CBC_SHA",
        "TLS_RSA_WITH_3DES_EDE_CBC_SHA"
